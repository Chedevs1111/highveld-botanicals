<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ shop.name }}</title>
    {% style %}
      :root {
        --hb-bg: {{ settings.color_background }};
        --hb-surface: {{ settings.color_surface }};
        --hb-ink: {{ settings.color_text }};
        --hb-muted: {{ settings.color_text | color_mix: settings.color_background, 55 }};
        --hb-accent: {{ settings.color_accent }};
        --hb-accent-ink: {{ settings.color_accent_text }};
        --hb-border: {{ settings.color_text | color_mix: settings.color_background, 15 }};
        --hb-radius: {{ settings.corner_radius }}px;
        --hb-width: {{ settings.page_width }}px;
      }
    {% endstyle %}
    {{ content_for_header }}
  </head>

  <body class="hb-body">
    {% render 'base-styles' %}

    <main class="hb-password">
      <div class="hb-password__panel">
        <p class="hb-eyebrow">{{ shop.name }}</p>
        <h1 class="hb-password__title">{{ 'password.title' | t }}</h1>
        <p class="hb-muted">{{ 'password.body' | t }}</p>

        {% form 'storefront_password', class: 'hb-form' %}
          {{ form.errors | default_errors }}
          <label class="hb-form__field">
            <span class="hb-form__label">{{ 'password.label' | t }}</span>
            <input class="hb-form__input" type="password" name="password" autocomplete="current-password">
          </label>
          <button type="submit" class="hb-btn hb-btn--primary">{{ 'password.submit' | t }}</button>
        {% endform %}
      </div>
    </main>

    {{ content_for_layout }}
  </body>
</html>
