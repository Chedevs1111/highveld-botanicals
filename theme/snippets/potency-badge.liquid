{% doc %}
  Renders the cannabinoid potency summary for a product, choosing between
  percentage and milligram display depending on which metafields are populated.

  @param {product} product - The product to read cannabinoid metafields from
  @param {string} [size] - Visual size, either 'small' or 'large'. Defaults to 'small'

  @example
  {% render 'potency-badge', product: product, size: 'large' %}
{% enddoc %}

{% liquid
  assign badge_size = size | default: 'small'
  assign thc_pct = product.metafields.custom.thc_percentage.value
  assign cbd_pct = product.metafields.custom.cbd_percentage.value
  assign thc_mg = product.metafields.custom.thc_mg.value
  assign cbd_mg = product.metafields.custom.cbd_mg.value
%}

<ul class="hb-potency hb-potency--{{ badge_size }}">
  {% if thc_pct != blank %}
    <li class="hb-potency__item">
      <span class="hb-potency__label">{{ 'product.thc' | t }}</span>
      <span class="hb-potency__value">{{ thc_pct }}%</span>
    </li>
  {% elsif thc_mg != blank %}
    <li class="hb-potency__item">
      <span class="hb-potency__label">{{ 'product.thc' | t }}</span>
      <span class="hb-potency__value">{{ thc_mg }}mg</span>
    </li>
  {% endif %}

  {% if cbd_pct != blank %}
    <li class="hb-potency__item">
      <span class="hb-potency__label">{{ 'product.cbd' | t }}</span>
      <span class="hb-potency__value">{{ cbd_pct }}%</span>
    </li>
  {% elsif cbd_mg != blank %}
    <li class="hb-potency__item">
      <span class="hb-potency__label">{{ 'product.cbd' | t }}</span>
      <span class="hb-potency__value">{{ cbd_mg }}mg</span>
    </li>
  {% endif %}

  {% if product.metafields.custom.strain_type != blank %}
    <li class="hb-potency__item hb-potency__item--strain">
      <span class="hb-potency__label">{{ 'product.strain' | t }}</span>
      <span class="hb-potency__value">{{ product.metafields.custom.strain_type }}</span>
    </li>
  {% endif %}
</ul>

{% stylesheet %}
  .hb-potency {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hb-potency__item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--hb-border);
    border-radius: calc(var(--hb-radius) / 2);
    background: var(--hb-bg);
  }

  .hb-potency__label {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hb-muted);
  }

  .hb-potency__value {
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .hb-potency--large .hb-potency__item {
    padding: 0.65rem 1rem;
  }

  .hb-potency--large .hb-potency__value {
    font-size: 1.125rem;
  }
{% endstylesheet %}
