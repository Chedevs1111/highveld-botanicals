<footer class="hb-footer">
  <div class="hb-container hb-footer__inner">
    <div class="hb-footer__brand">
      <p class="hb-footer__wordmark">{{ shop.name }}</p>
      {% if section.settings.blurb != blank %}
        <p class="hb-muted hb-footer__blurb">{{ section.settings.blurb }}</p>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      <nav class="hb-footer__col" {{ block.shopify_attributes }}>
        <h2 class="hb-footer__heading">{{ block.settings.heading }}</h2>
        <ul class="hb-footer__links">
          {% for link in block.settings.menu.links %}
            <li><a class="hb-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endfor %}
  </div>

  <div class="hb-container hb-footer__legal">
    {% if section.settings.compliance_notice != blank %}
      <p class="hb-footer__compliance">{{ section.settings.compliance_notice }}</p>
    {% endif %}
    <p class="hb-muted hb-footer__copy">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}
    </p>
  </div>
</footer>

{% stylesheet %}
  .hb-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--hb-border);
    background: var(--hb-surface);
  }

  .hb-footer__inner {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem 2rem;
    grid-template-columns: 1fr;
  }

  .hb-footer__wordmark {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .hb-footer__blurb {
    margin: 0;
    max-width: 28ch;
    font-size: 0.875rem;
  }

  .hb-footer__heading {
    margin: 0 0 0.875rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hb-muted);
  }

  .hb-footer__links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hb-footer__link {
    color: var(--hb-ink);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .hb-footer__link:hover {
    color: var(--hb-accent);
  }

  .hb-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding-block: 1.5rem;
    border-top: 1px solid var(--hb-border);
  }

  .hb-footer__compliance {
    margin: 0;
    max-width: 62ch;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--hb-muted);
  }

  .hb-footer__copy {
    margin: 0;
    font-size: 0.75rem;
  }

  @media (min-width: 46rem) {
    .hb-footer__inner {
      grid-template-columns: 1.5fr repeat(auto-fit, minmax(9rem, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "id": "blurb",
      "label": "t:labels.blurb",
      "default": "A members-only botanical collective."
    },
    {
      "type": "textarea",
      "id": "compliance_notice",
      "label": "t:labels.compliance_notice",
      "default": "Access is limited to verified members aged 18 and over. Amounts shown are member contributions toward cultivation and handling, not a public retail sale. Nothing on this site is medical advice."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:blocks.menu.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        }
      ]
    }
  ]
}
{% endschema %}
