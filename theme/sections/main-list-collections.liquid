<section class="hb-section">
  <div class="hb-container">
    <p class="hb-eyebrow">{{ 'collection.eyebrow' | t }}</p>
    <h1 class="hb-apply__title">{{ 'collections.title' | t }}</h1>

    <div class="hb-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <article class="hb-card">
            <a class="hb-card__link" href="{{ collection.url }}">
              <div class="hb-card__media">
                {% if collection.featured_image %}
                  {{
                    collection.featured_image
                    | image_url: width: 600
                    | image_tag: class: 'hb-card__image', loading: 'lazy', alt: collection.title
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'hb-card__image' }}
                {% endif %}
              </div>
              <div class="hb-card__body">
                <h2 class="hb-card__title">{{ collection.title }}</h2>
                <p class="hb-card__batch">
                  {{ 'collection.count' | t: count: collection.all_products_count }}
                </p>
              </div>
            </a>
          </article>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{ "name": "t:sections.main_list_collections.name", "settings": [] }
{% endschema %}
