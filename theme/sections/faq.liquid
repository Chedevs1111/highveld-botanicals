<section class="hb-section">
  <div class="hb-container hb-narrow">
    <p class="hb-eyebrow">{{ 'faq.eyebrow' | t }}</p>
    <h1 class="hb-apply__title">{{ section.settings.heading }}</h1>

    {% if section.settings.intro != blank %}
      <p class="hb-muted hb-pol__lead">{{ section.settings.intro }}</p>
    {% endif %}

    {% assign question_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'question' %}
        {% assign question_count = question_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if question_count == 0 %}
      <p class="hb-muted">{{ 'faq.empty' | t }}</p>
    {% endif %}

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'group' %}
          <h2 class="hb-pol__h2">{{ block.settings.title }}</h2>
        {% when 'question' %}
          <details class="hb-faq" {{ block.shopify_attributes }}>
            <summary class="hb-faq__q">{{ block.settings.question }}</summary>
            <div class="hb-faq__a">{{ block.settings.answer }}</div>
          </details>
      {% endcase %}
    {% endfor %}

    {% if section.settings.contact_page != blank %}
      <div class="hb-faq__foot">
        <h2 class="hb-faq__foot-title">{{ 'faq.still_stuck' | t }}</h2>
        <a class="hb-btn hb-btn--primary" href="{{ section.settings.contact_page }}">
          {{ 'faq.contact_us' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% liquid
  assign entities = ''
  for block in section.blocks
    if block.type == 'question'
      assign q = block.settings.question | strip_html | escape
      assign a = block.settings.answer | strip_html | escape
      capture entity
        echo '{"@type":"Question","name":"'
        echo q
        echo '","acceptedAnswer":{"@type":"Answer","text":"'
        echo a
        echo '"}}'
      endcapture
      if entities == ''
        assign entities = entity
      else
        assign entities = entities | append: ',' | append: entity
      endif
    endif
  endfor
%}

{% if entities != '' %}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ entities }}]}
  </script>
{% endif %}

{% stylesheet %}
  .hb-faq {
    border-bottom: 1px solid var(--hb-border);
  }

  .hb-faq__q {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 0;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    list-style: none;
  }

  .hb-faq__q::-webkit-details-marker {
    display: none;
  }

  .hb-faq__q::after {
    content: '+';
    margin-left: auto;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--hb-muted);
    line-height: 1;
  }

  .hb-faq[open] .hb-faq__q::after {
    content: '−';
    color: var(--hb-accent);
  }

  .hb-faq__q:hover {
    color: var(--hb-accent);
  }

  .hb-faq__a {
    padding: 0 0 1.25rem;
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--hb-muted);
  }

  .hb-faq__a strong {
    color: var(--hb-ink);
  }

  .hb-faq__foot {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius);
    background: var(--hb-surface);
  }

  .hb-faq__foot-title {
    margin: 0 0 1rem;
    font-size: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Frequently asked questions" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:labels.body",
      "default": "The things members actually ask. If the answer is not here, contact us."
    },
    { "type": "url", "id": "contact_page", "label": "t:labels.contact_page" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:blocks.group.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.heading", "default": "Membership" }
      ]
    },
    {
      "type": "question",
      "name": "t:blocks.question.name",
      "settings": [
        { "type": "text", "id": "question", "label": "t:labels.question" },
        { "type": "richtext", "id": "answer", "label": "t:labels.answer" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.faq.name" }]
}
{% endschema %}
