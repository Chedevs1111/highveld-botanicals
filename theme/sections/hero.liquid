<section class="hb-hero">
  <div class="hb-container hb-hero__inner">
    <div class="hb-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="hb-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="hb-hero__title">{{ section.settings.heading }}</h1>

      {% if section.settings.body != blank %}
        <p class="hb-hero__body">{{ section.settings.body }}</p>
      {% endif %}

      <div class="hb-hero__actions">
        {% if section.settings.primary_url != blank %}
          <a class="hb-btn hb-btn--primary" href="{{ section.settings.primary_url }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_url != blank %}
          <a class="hb-btn hb-btn--ghost" href="{{ section.settings.secondary_url }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>

      <ul class="hb-hero__trust">
        {% for block in section.blocks %}
          <li class="hb-hero__trust-item" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value }}</strong>
            <span>{{ block.settings.label }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>

    {% if section.settings.image %}
      <div class="hb-hero__media">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: class: 'hb-hero__image', widths: '600, 900, 1200', loading: 'eager', alt: section.settings.heading
        }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hb-hero {
    border-bottom: 1px solid var(--hb-border);
    background: linear-gradient(180deg, var(--hb-surface), var(--hb-bg));
  }

  .hb-hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    grid-template-columns: 1fr;
  }

  .hb-hero__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hb-hero__body {
    margin: 0 0 2rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    color: var(--hb-muted);
  }

  .hb-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hb-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--hb-border);
    list-style: none;
  }

  .hb-hero__trust-item {
    display: flex;
    flex-direction: column;
  }

  .hb-hero__trust-item strong {
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }

  .hb-hero__trust-item span {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--hb-muted);
  }

  .hb-hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--hb-radius);
    display: block;
  }

  @media (min-width: 52rem) {
    .hb-hero__inner {
      grid-template-columns: 1.05fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Members only" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Landrace genetics, kept honest." },
    { "type": "textarea", "id": "body", "label": "t:labels.body", "default": "A small, verified collective growing South African landrace cultivars. Every batch is lab-tested and the certificate is on the product page." },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "primary_label", "label": "t:labels.primary_label", "default": "Browse the collection" },
    { "type": "url", "id": "primary_url", "label": "t:labels.primary_url" },
    { "type": "text", "id": "secondary_label", "label": "t:labels.secondary_label", "default": "How membership works" },
    { "type": "url", "id": "secondary_url", "label": "t:labels.secondary_url" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:blocks.stat.name",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "t:labels.value", "default": "100%" },
        { "type": "text", "id": "label", "label": "t:labels.label", "default": "Batch tested" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}
