<section class="hb-section">
  <div class="hb-container">
    <div class="hb-section__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="hb-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="hb-section__title">{{ section.settings.heading }}</h2>
      </div>

      {% if section.settings.collection != blank %}
        <a class="hb-btn hb-btn--ghost" href="{{ section.settings.collection.url }}">
          {{ 'collection.view_all' | t }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection.products.size > 0 %}
      <div class="hb-grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="hb-muted">{{ 'collection.empty' | t }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_products.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "This week" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Current batches" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "t:sections.featured_products.name" }]
}
{% endschema %}
