<section class="hb-section">
  <div class="hb-container hb-narrow">
    <p class="hb-eyebrow">{{ 'customer.eyebrow' | t }}</p>
    <h1 class="hb-apply__title">{{ 'customer.reset_title' | t }}</h1>

    {% form 'reset_customer_password', class: 'hb-form' %}
      {{ form.errors | default_errors }}

      <label class="hb-form__field">
        <span class="hb-form__label">{{ 'customer.new_password' | t }}</span>
        <input class="hb-form__input" type="password" name="customer[password]" autocomplete="new-password" required>
      </label>

      <label class="hb-form__field">
        <span class="hb-form__label">{{ 'customer.confirm_password' | t }}</span>
        <input class="hb-form__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </label>

      <button type="submit" class="hb-btn hb-btn--primary">{{ 'customer.reset_submit' | t }}</button>
    {% endform %}
  </div>
</section>
